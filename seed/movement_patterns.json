      { "slot": 2, "pattern": "hinge",              "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 120, "band": "medium", "warmup_sets": 0, "alt_pattern_if_slot1_pattern": { "hinge": "squat" } },
      { "slot": 3, "pattern": "quad_isolation",     "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 90,  "band": "medium", "warmup_sets": 0 },
      { "slot": 4, "pattern": "hamstring_isolation","sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 90,  "band": "medium", "warmup_sets": 0 },
      { "slot": 5, "pattern": "calf",               "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0 },
      { "slot": 6, "pattern": "core",               "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0, "superset": true }
    ]
  },

  "heavy_rotation_defaults": {
