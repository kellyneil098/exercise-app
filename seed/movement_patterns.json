    "pull": [
      { "slot": 1, "pattern": "heavy_rotation",     "sets": 4, "rep_low": 5,  "rep_high": 8,  "rest_seconds": 180, "band": "heavy",  "warmup_sets": 2 },
      { "slot": 2, "pattern": "vertical_pull",      "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 120, "band": "medium", "warmup_sets": 0 },
      { "slot": 3, "pattern": "horizontal_row",     "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 90,  "band": "medium", "warmup_sets": 0, "omit_if_slot1_pattern": "horizontal_row" },
      { "slot": 4, "pattern": "elbow_flexion",      "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 75,  "band": "medium", "warmup_sets": 0 },
      { "slot": 5, "pattern": "rear_delt",          "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0 },
      { "slot": 6, "pattern": "core",               "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0, "superset": true }
    ],
    "legs": [
