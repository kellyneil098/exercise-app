{
  "$comment": "movement_pattern drives substitution (§3.2): two exercises sharing a pattern are valid swaps. strength_cluster drives rebaselining (§4.4): growth transfers only within a cluster. They are deliberately NOT the same axis — e.g. barbell_row and chest_supported_row share both, but weighted_pull_up and lat_pulldown share a pattern while sitting in the same cluster as barbell_row does not.",

  "movement_patterns": [
    { "key": "horizontal_press",    "day_type": "push",  "cluster": "horizontal_press" },
    { "key": "vertical_press",      "day_type": "push",  "cluster": "vertical_press" },
    { "key": "incline_press",       "day_type": "push",  "cluster": "horizontal_press" },
    { "key": "chest_fly",           "day_type": "push",  "cluster": "chest_isolation" },
    { "key": "lateral_raise",       "day_type": "push",  "cluster": "lateral_delt" },
    { "key": "triceps_extension",   "day_type": "push",  "cluster": "triceps" },

    { "key": "vertical_pull",       "day_type": "pull",  "cluster": "vertical_pull" },
    { "key": "horizontal_row",      "day_type": "pull",  "cluster": "row" },
    { "key": "rear_delt",           "day_type": "pull",  "cluster": "rear_delt" },
    { "key": "elbow_flexion",       "day_type": "pull",  "cluster": "elbow_flexion" },

    { "key": "squat",               "day_type": "legs",  "cluster": "squat" },
    { "key": "hinge",               "day_type": "legs",  "cluster": "hinge" },
    { "key": "quad_isolation",      "day_type": "legs",  "cluster": "quad_isolation" },
    { "key": "hamstring_isolation", "day_type": "legs",  "cluster": "hamstring_isolation" },
    { "key": "calf",                "day_type": "legs",  "cluster": "calf" },

    { "key": "core",                "day_type": "any",   "cluster": "core" }
  ],

  "$comment_slots": "Slots are priority-ordered (§4.1). omit_if_slot1_pattern drops the slot when the heavy rotation already used that pattern. alt_pattern_if_slot1_pattern swaps the slot's pattern instead, so leg day always carries one squat and one hinge. Slot 7 only ever fits at 60/90 minutes. band=heavy slots require loadable exercises.",

  "$comment_hinge": "hinge appears in the pull-day heavy rotation as well as on leg day (§3.4). The pattern's day_type is its home, not a restriction — the heavy rotation may pull it onto pull day.",

  "slot_templates": {
    "push": [
      { "slot": 1, "pattern": "heavy_rotation",     "sets": 4, "rep_low": 5,  "rep_high": 8,  "rest_seconds": 180, "band": "heavy",  "warmup_sets": 2 },
      { "slot": 2, "pattern": "vertical_press",     "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 120, "band": "medium", "warmup_sets": 0, "omit_if_slot1_pattern": "vertical_press" },
      { "slot": 3, "pattern": "incline_press",      "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 90,  "band": "medium", "warmup_sets": 0 },
      { "slot": 4, "pattern": "triceps_extension",  "sets": 3, "rep_low": 8,  "rep_high": 12, "rest_seconds": 75,  "band": "medium", "warmup_sets": 0 },
      { "slot": 5, "pattern": "lateral_raise",      "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0 },
      { "slot": 6, "pattern": "core",               "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0, "superset": true },
      { "slot": 7, "pattern": "chest_fly",          "sets": 3, "rep_low": 15, "rep_high": 20, "rest_seconds": 60,  "band": "volume", "warmup_sets": 0 }
